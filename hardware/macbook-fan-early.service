[Unit]
Description=CPU-temperature fan profiles for MacBookPro15,4
Conflicts=sleep.target
Before=sleep.target

[Service]
Type=notify
ExecStart=/usr/local/libexec/macbook-thermal-fan run
ExecStopPost=/usr/local/libexec/macbook-thermal-fan release
RuntimeDirectory=macbook-fan-profile
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
TimeoutStartSec=10
TimeoutStopSec=8
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
